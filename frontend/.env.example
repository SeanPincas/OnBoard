# Copy to .env.local. Keep real values out of source control and chat.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk development application (Phase 3)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Use URL and publishable key from the same local or hosted Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only; leave empty until privileged operations need it.
SUPABASE_SECRET_KEY=
